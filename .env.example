# SynapseHub environment template
# Copy this file to `.env` and adjust values as needed.

# -----------------------------------------------------------------------------
# Runtime mode
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# API gateway (apps/api)
# -----------------------------------------------------------------------------
PORT=4000
AUTH_SERVICE_URL=http://localhost:4001
USER_SERVICE_URL=http://localhost:4002
WORKSPACE_SERVICE_URL=http://localhost:4003
CHANNEL_SERVICE_URL=http://localhost:4004
MESSAGING_SERVICE_URL=http://localhost:4005
NOTIFICATION_SERVICE_URL=http://localhost:4006
FILE_SERVICE_URL=http://localhost:4007
SEARCH_SERVICE_URL=http://localhost:4008

# Gateway security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_PER_MINUTE=300

# -----------------------------------------------------------------------------
# Auth and tokens (auth-service + gateway + websocket auth)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
REQUIRE_EMAIL_VERIFICATION=false
PUBLIC_WEB_URL=http://localhost:3000

# Email delivery (single third-party provider recommended)
EMAIL_PROVIDER=console
EMAIL_FROM=SynapseHub <no-reply@synapsehub.local>
EMAIL_REPLY_TO=support@synapsehub.local
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Shared data dependencies (used by domain services)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/synapsehub
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_NODE=http://localhost:9200

# -----------------------------------------------------------------------------
# S3-compatible storage (file-service)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=synapsehub-files
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# -----------------------------------------------------------------------------
# Web app (apps/web)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Optional local infra defaults (docker-compose reference)
# -----------------------------------------------------------------------------
POSTGRES_DB=synapsehub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# 1) Each backend service reads `PORT`. When running services individually,
#    set `PORT` per service before starting:
#    auth=4001, user=4002, workspace=4003, channel=4004,
#    messaging=4005, notification=4006, file=4007, search=4008.
# 2) OAuth/SSO/SCIM, Stripe, and external product connectors are currently out
#    of scope in this codebase.

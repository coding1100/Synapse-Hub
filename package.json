{
  "name": "synapsehub",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @synapsehub/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --config jest.unit.config.js --runInBand",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,tf}\"",
    "prisma:generate": "npm run prisma:generate --workspace @synapsehub/shared",
    "prisma:migrate": "npm run prisma:migrate --workspace @synapsehub/shared"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.8",
    "@playwright/test": "^1.52.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.2",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
